# Application
APP_ENV=local
INTEGRATION_MODE=fake
# Opt in only for the single real production web process. The in-process
# recovery loop remains off in local and preview environments.
TRELLO_RECOVERY_RUNNER_ENABLED=false

# Supabase (server-side credentials must never be prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low

# Composio and operational integrations
COMPOSIO_API_KEY=
COMPOSIO_GOOGLE_CALENDAR_USER_ID=
COMPOSIO_GOOGLE_CALENDAR_CONNECTED_ACCOUNT_ID=
COMPOSIO_GOOGLE_CALENDAR_TOOLKIT_VERSION=
COMPOSIO_TRELLO_USER_ID=
COMPOSIO_TRELLO_CONNECTED_ACCOUNT_ID=
COMPOSIO_TRELLO_TOOLKIT_VERSION=20260812_00
TRELLO_BOARD_ID=
TRELLO_HUMAN_NEEDED_LABEL_ID=
TEAM_A_CALENDAR_ID=
TEAM_B_CALENDAR_ID=

# Public embeds are limited to non-sensitive URLs.
NEXT_PUBLIC_TEAM_A_CALENDAR_EMBED_URL=
NEXT_PUBLIC_TEAM_B_CALENDAR_EMBED_URL=
NEXT_PUBLIC_MIRO_EMBED_URL=
NEXT_PUBLIC_MIRO_BOARD_URL=
